{
  "name": "@hive-chameleon/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PostgreSQL client, transaction, and UUIDv7 conventions for Hive Chameleon",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "pg": "8.22.0",
    "uuid": "14.0.1"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "vitest": "4.1.10"
  }
}
