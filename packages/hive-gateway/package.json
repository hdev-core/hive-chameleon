{
  "name": "@hive-chameleon/hive-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Typed Hive protocol, WAX transaction, and isolated signer-policy boundary",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "import": "./dist/protocol/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hiveio/wax": "2.0.2",
    "canonicalize": "3.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
