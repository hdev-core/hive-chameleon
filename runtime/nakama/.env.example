# Copy to .env and replace every value. These placeholders are intentionally nonfunctional.
NAKAMA_DATABASE_PASSWORD=replace-with-a-random-local-password
NAKAMA_SERVER_KEY=replace-with-a-unique-public-application-key
NAKAMA_RUNTIME_HTTP_KEY=replace-with-a-random-runtime-http-key
NAKAMA_BRIDGE_HMAC_KEY=replace-with-32-random-bytes-as-unpadded-base64url
NAKAMA_SESSION_ENCRYPTION_KEY=replace-with-a-random-session-encryption-key
NAKAMA_REFRESH_ENCRYPTION_KEY=replace-with-a-different-random-refresh-key
NAKAMA_CONSOLE_USERNAME=local-admin
NAKAMA_CONSOLE_PASSWORD=replace-with-a-random-console-password
NAKAMA_CONSOLE_SIGNING_KEY=replace-with-a-random-console-signing-key

# NestJS public/internal endpoints for local development.
NAKAMA_HTTP_URL=http://127.0.0.1:7350
NAKAMA_SOCKET_URL=ws://127.0.0.1:7350/ws

# Temporary local-only principal. The API refuses this mode in production.
REALTIME_DEV_PRINCIPAL_ENABLED=true
REALTIME_DEV_DISCLOSURE_ACKNOWLEDGED=true
REALTIME_DEV_PLAYER_ID=01980abc-def0-7abc-8def-0123456789ab
REALTIME_DEV_AUTH_SESSION_ID=01980abc-def1-7abc-9def-0123456789ab
REALTIME_DEV_BEARER_TOKEN=replace-with-at-least-32-random-characters

# Optional exact browser origins for a separately served local WebGL build (comma-separated).
HTTP_CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000
