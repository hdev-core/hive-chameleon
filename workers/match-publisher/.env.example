NODE_ENV=development
DATABASE_URL=postgres://app_login:replace-me@localhost:5433/hive_chameleon?sslmode=disable

MATCH_PUBLISHER_HIVE_RPC_URL=https://api.hive.blog/
# MATCH_PUBLISHER_HIVE_REST_API_URL=https://api.hive.blog/
MATCH_PUBLISHER_HIVE_CHAIN_ID=replace-with-64-lowercase-hex-characters
MATCH_PUBLISHER_HIVE_ACCOUNT=replace-me
MATCH_PUBLISHER_PUBLIC_KEY=replace-with-posting-public-key
MATCH_PUBLISHER_SIGNER_KEY_REFERENCE=replace-with-opaque-key-reference
MATCH_PUBLISHER_SIGNER_POLICY_VERSION=match-policy-1
MATCH_PUBLISHER_SIGNER_URL=https://signer.internal.example/v1/sign
MATCH_PUBLISHER_SIGNER_BEARER_TOKEN=replace-with-at-least-32-random-characters

# Defaults: five minutes, 20 results, and 6 KiB. Lower values are supported for drills.
MATCH_PUBLISHER_BATCH_MAXIMUM_AGE_MS=300000
MATCH_PUBLISHER_BATCH_MAXIMUM_RESULTS=20
MATCH_PUBLISHER_BATCH_MAXIMUM_PAYLOAD_BYTES=6144
MATCH_PUBLISHER_TRANSACTION_EXPIRATION_SECONDS=300
MATCH_PUBLISHER_CLAIM_LEASE_MS=120000
MATCH_PUBLISHER_POLL_INTERVAL_MS=1000
MATCH_PUBLISHER_INITIAL_RETRY_BACKOFF_MS=1000
MATCH_PUBLISHER_MAXIMUM_RETRY_BACKOFF_MS=60000
MATCH_PUBLISHER_DATABASE_POOL_MAX=10
MATCH_PUBLISHER_DATABASE_CONNECTION_TIMEOUT_MS=5000
MATCH_PUBLISHER_HIVE_API_TIMEOUT_MS=5000
MATCH_PUBLISHER_SIGNER_TIMEOUT_MS=5000
