NODE_ENV=development

# Supply deployment-specific identities and endpoints. These placeholders are not live services.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
HAF_PROJECTOR_SOURCE_NAME=hive-mainnet
HAF_PROJECTOR_HAFAH_API_URL=https://HAFAH_HOST/
HAF_PROJECTOR_HIVE_RPC_URL=https://HIVE_RPC_HOST/

# HAfAH provider operation type IDs and the exact normalized collectible-issuer allow-list.
HAF_PROJECTOR_OPERATION_TYPE_IDS=OPERATION_TYPE_ID
HAF_PROJECTOR_COLLECTIBLE_ISSUERS=

HAF_PROJECTOR_DATABASE_POOL_MAX=10
HAF_PROJECTOR_DATABASE_CONNECTION_TIMEOUT_MS=5000
HAF_PROJECTOR_PAGE_SIZE=1000
HAF_PROJECTOR_REQUEST_TIMEOUT_MS=5000
HAF_PROJECTOR_MAX_BLOCKS_PER_RUN=50
HAF_PROJECTOR_MAX_REORG_DEPTH=200
HAF_PROJECTOR_MAXIMUM_FUTURE_CLOCK_SKEW_MS=300000
HAF_PROJECTOR_POLL_INTERVAL_MS=1000
HAF_PROJECTOR_INITIAL_FAILURE_BACKOFF_MS=1000
HAF_PROJECTOR_MAXIMUM_FAILURE_BACKOFF_MS=30000
