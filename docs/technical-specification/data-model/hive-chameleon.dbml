Project hive_chameleon {
  database_type: 'PostgreSQL'
  Note: '''
    Application-owned relational model for Hive Chameleon.
    UUIDv7 values are generated by application services and stored as PostgreSQL uuid.
    Nakama, Redis, HAF internal tables, and object-storage contents are outside this model.
  '''
}

TablePartial created_record {
  created_at timestamptz [not null, default: `now()`]
}

TablePartial mutable_record {
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

TablePartial optimistic_lock {
  row_version bigint [not null, default: 1]
}

