Table identity.player {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  hive_username varchar(16) [not null, unique]
  hive_control_state identity.hive_control_state [not null]
  ~created_record

  checks {
    `hive_username = lower(hive_username)` [name: 'chk_player_hive_username_lower']
  }

  Note: 'Playable identity. Direct-Hive login may create it after signature verification; Google provisioning creates it only when the real Hive account, expected authorities, and initial RC are verified ready. No guest/pending player is stored.'
}

Table identity.hive_login_challenge {
  id uuid [pk, not null, note: 'Application-generated UUIDv7; unguessable single-use handle']
  hive_username varchar(16) [not null]
  platform identity.client_platform [not null]
  device_session_id uuid [not null]
  challenge_text text [not null]
  challenge_sha256 char(64) [not null, unique]
  issued_at timestamptz [not null]
  expires_at timestamptz [not null]
  consumed_at timestamptz

  indexes {
    (expires_at, consumed_at) [name: 'idx_hive_login_challenge_expiry']
  }

  checks {
    `hive_username = lower(hive_username)` [name: 'chk_hive_login_challenge_username_lower']
    `expires_at > issued_at` [name: 'chk_hive_login_challenge_expiry']
    `consumed_at IS NULL OR consumed_at >= issued_at` [name: 'chk_hive_login_challenge_consumed']
    `encode(digest(convert_to(challenge_text, 'UTF8'), 'sha256'), 'hex') = challenge_sha256` [name: 'chk_hive_login_challenge_hash']
  }

  Note: 'Canonical login text is public; the random nonce and UUID make a challenge unguessable. Consumption is atomic and occurs before signature verification so one handle cannot be replayed.'
}

Table identity.external_identity {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  provider identity.external_identity_provider [not null]
  verified_issuer varchar(255) [not null]
  subject_lookup_hash char(64) [not null]
  player_id uuid [unique]
  status identity.external_identity_status [not null, default: 'provisioning']
  verified_at timestamptz [not null]
  linked_at timestamptz
  last_authenticated_at timestamptz [not null]
  ~mutable_record

  indexes {
    (provider, verified_issuer, subject_lookup_hash) [unique, name: 'uq_external_identity_subject']
    (status, last_authenticated_at) [name: 'idx_external_identity_status']
  }

  checks {
    `last_authenticated_at >= verified_at` [name: 'chk_external_identity_auth_time']
    `(status <> 'linked') OR (player_id IS NOT NULL AND linked_at IS NOT NULL)` [name: 'chk_external_identity_linked']
  }

  Note: 'subject_lookup_hash is a keyed deterministic HMAC-SHA-256 of the canonical verified issuer/subject pair; the HMAC key and raw subject/token material remain outside PostgreSQL. Email is never an ownership key.'
}

Table identity.hive_account_provisioning {
  id uuid [pk, not null, note: 'Application-generated UUIDv7; stable logical provisioning job']
  external_identity_id uuid [not null, unique]
  resulting_player_id uuid [unique]
  idempotency_key varchar(128) [not null, unique]
  requested_hive_username varchar(16) [not null]
  state identity.provisioning_state [not null, default: 'username_confirmed']
  sponsor_program varchar(64) [not null]
  sponsor_policy_version varchar(32) [not null]
  sponsor_hive_account varchar(16) [not null]
  sponsor_request_reference varchar(128) [note: 'Opaque, non-secret reference returned by the approved signup sponsor']
  account_creation_transaction_id varchar(128)
  account_creation_operation_id uuid [unique]
  initial_rc_delegation_id uuid [unique]
  username_confirmed_at timestamptz [not null]
  keys_ready_at timestamptz
  account_observed_at timestamptz
  account_irreversible_at timestamptz
  authorities_verified_at timestamptz
  rc_verified_at timestamptz
  attempt_count integer [not null, default: 0]
  last_attempt_at timestamptz
  next_retry_at timestamptz
  last_failure_code varchar(64)
  ready_at timestamptz
  ~mutable_record
  ~optimistic_lock

  indexes {
    (requested_hive_username, state) [name: 'idx_provisioning_username']
    (state, next_retry_at) [name: 'idx_provisioning_retry']
    (sponsor_program, sponsor_request_reference) [unique, name: 'uq_provisioning_sponsor_request']
    account_creation_transaction_id [name: 'idx_provisioning_creation_tx']
  }

  checks {
    `requested_hive_username = lower(requested_hive_username)` [name: 'chk_provisioning_username_lower']
    `sponsor_hive_account = lower(sponsor_hive_account)` [name: 'chk_provisioning_sponsor_account_lower']
    `attempt_count >= 0` [name: 'chk_provisioning_attempts']
    `(state <> 'keys_ready') OR keys_ready_at IS NOT NULL` [name: 'chk_provisioning_keys_ready']
    `(state <> 'account_created') OR account_observed_at IS NOT NULL` [name: 'chk_provisioning_account_created']
    `(state <> 'rc_delegated') OR initial_rc_delegation_id IS NOT NULL` [name: 'chk_provisioning_rc_delegated']
    `(state <> 'ready') OR (resulting_player_id IS NOT NULL AND keys_ready_at IS NOT NULL AND account_irreversible_at IS NOT NULL AND authorities_verified_at IS NOT NULL AND initial_rc_delegation_id IS NOT NULL AND rc_verified_at IS NOT NULL AND ready_at IS NOT NULL)` [name: 'chk_provisioning_ready']
  }

  Note: 'One row is retried through partial and uncertain sponsor outcomes; no player or playable auth_session exists until ready. Migration makes requested_hive_username unique for every job except a terminal failure with no observed account, and immutable after any matching account is observed. Raw signup codes and sponsor API credentials are never stored.'
}

Table identity.custody_key_reference {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  provisioning_id uuid [not null]
  player_id uuid
  authority_role identity.hive_key_role [not null]
  hive_public_key varchar(64) [not null]
  custody_provider_key_reference text [not null, unique]
  state identity.custody_key_state [not null, default: 'generated']
  activated_at timestamptz
  destruction_requested_at timestamptz
  destruction_completed_at timestamptz
  destruction_evidence_reference text
  ~created_record

  indexes {
    (provisioning_id, authority_role, state) [name: 'idx_custody_key_provisioning_role']
    (player_id, authority_role, state) [name: 'idx_custody_key_player_role']
  }

  checks {
    `(state <> 'active') OR activated_at IS NOT NULL` [name: 'chk_custody_key_active']
    `(state <> 'destruction_requested') OR destruction_requested_at IS NOT NULL` [name: 'chk_custody_key_destruction_requested']
    `(state <> 'destroyed') OR (destruction_requested_at IS NOT NULL AND destruction_completed_at IS NOT NULL)` [name: 'chk_custody_key_destroyed']
  }

  Note: 'Stores only a Hive public key, an opaque provider reference, and non-secret lifecycle evidence. Migration adds partial unique indexes for one nondestroyed key per provisioning/player and authority role; four roles are required before keys_ready.'
}

Table identity.hive_account_claim {
  id uuid [pk, not null, note: 'Application-generated UUIDv7; stable claim request identity']
  player_id uuid [not null]
  idempotency_key varchar(128) [not null, unique]
  state identity.claim_state [not null, default: 'requested']
  target_owner_authority_canonical text [not null]
  target_active_authority_canonical text [not null]
  target_posting_authority_canonical text [not null]
  target_memo_public_key varchar(64) [not null]
  prior_recovery_hive_account varchar(16) [not null]
  selected_recovery_hive_account varchar(16) [not null]
  transaction_intent_id uuid [unique]
  change_recovery_operation_id uuid [unique]
  account_update_operation_id uuid [unique]
  changed_recovery_virtual_operation_id uuid [unique]
  authority_rotation_included_at timestamptz
  authority_rotation_irreversible_at timestamptz
  recovery_request_verified_at timestamptz
  custodial_signing_disabled_at timestamptz
  key_destruction_completed_at timestamptz
  recovery_effective_expected_at timestamptz
  recovery_effective_at timestamptz
  attempt_count integer [not null, default: 0]
  last_attempt_at timestamptz
  next_retry_at timestamptz
  last_failure_code varchar(64)
  requested_at timestamptz [not null, default: `now()`]
  completed_at timestamptz
  updated_at timestamptz [not null, default: `now()`]
  ~optimistic_lock

  indexes {
    (player_id, state) [name: 'idx_hive_account_claim_player_state']
    (state, next_retry_at) [name: 'idx_hive_account_claim_retry']
    selected_recovery_hive_account [name: 'idx_hive_account_claim_recovery']
  }

  checks {
    `prior_recovery_hive_account = lower(prior_recovery_hive_account)` [name: 'chk_claim_prior_recovery_lower']
    `selected_recovery_hive_account = lower(selected_recovery_hive_account)` [name: 'chk_claim_target_recovery_lower']
    `prior_recovery_hive_account <> selected_recovery_hive_account` [name: 'chk_claim_nonplatform_recovery']
    `attempt_count >= 0` [name: 'chk_claim_attempts']
    `recovery_effective_expected_at IS NULL OR recovery_effective_expected_at >= requested_at` [name: 'chk_claim_recovery_expected']
    `(state <> 'recovery_change_pending') OR (authority_rotation_irreversible_at IS NOT NULL AND recovery_request_verified_at IS NOT NULL AND custodial_signing_disabled_at IS NOT NULL AND key_destruction_completed_at IS NOT NULL)` [name: 'chk_claim_recovery_pending']
    `(state <> 'self_custody_complete') OR (authority_rotation_irreversible_at IS NOT NULL AND custodial_signing_disabled_at IS NOT NULL AND key_destruction_completed_at IS NOT NULL AND recovery_effective_at IS NOT NULL AND changed_recovery_virtual_operation_id IS NOT NULL AND completed_at IS NOT NULL)` [name: 'chk_claim_complete']
  }

  Note: 'The two owner-authorized operations must share one transaction. Canonical authority text is public, deterministic operation input—not private material. Completion waits for the approximately 30-day recovery-account transition and changed_recovery_account verification. Migration adds one pending claim per player.'
}

Table identity.public_record_disclosure {
  disclosure_version varchar(32) [pk, not null]
  content_sha256 char(64) [not null]
  effective_at timestamptz [not null]
  retired_at timestamptz
  ~created_record

  checks {
    `retired_at IS NULL OR retired_at > effective_at` [name: 'chk_public_disclosure_retired']
  }

  Note: 'Versioned product disclosure for permanent Hive match-summary fields; this is not a generic legal-consent table.'
}

Table identity.public_record_disclosure_acknowledgment {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  disclosure_version varchar(32) [not null]
  external_identity_id uuid
  player_id uuid
  source identity.disclosure_ack_source [not null]
  acknowledged_at timestamptz [not null]
  player_linked_at timestamptz

  indexes {
    (external_identity_id, disclosure_version) [name: 'idx_disclosure_ack_external']
    (player_id, disclosure_version) [name: 'idx_disclosure_ack_player']
    disclosure_version [name: 'idx_disclosure_ack_version']
  }

  checks {
    `external_identity_id IS NOT NULL OR player_id IS NOT NULL` [name: 'chk_disclosure_ack_subject']
    `player_linked_at IS NULL OR player_id IS NOT NULL` [name: 'chk_disclosure_ack_player_link']
    `(source <> 'google_pre_provisioning') OR external_identity_id IS NOT NULL` [name: 'chk_disclosure_ack_google_subject']
    `(source <> 'direct_hive_pre_participation') OR player_id IS NOT NULL` [name: 'chk_disclosure_ack_hive_subject']
  }

  Note: 'The Google row is updated with player_id after provisioning instead of duplicated. Migration adds partial unique indexes per non-null external identity/player and disclosure version. No IP, device, browser, email, or token data is stored.'
}

Table identity.player_profile {
  player_id uuid [pk, not null]
  hive_display_name varchar(128)
  avatar_url text
  hive_profile_metadata jsonb [not null, default: '{}']
  hive_synced_at timestamptz
  last_seen_at timestamptz
  ~mutable_record
  ~optimistic_lock
}

Table identity.auth_session {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  player_id uuid [not null]
  external_identity_id uuid
  refresh_token_hash char(64) [not null, unique]
  platform identity.client_platform [not null]
  authentication_method identity.authentication_method [not null]
  hive_signing_provider identity.signing_provider
  hive_control_state_at_issue identity.hive_control_state [not null]
  custodial_signing_eligible boolean [not null, default: false]
  issued_at timestamptz [not null, default: `now()`]
  last_used_at timestamptz
  expires_at timestamptz [not null]
  revoked_at timestamptz
  revocation_reason varchar(64)

  indexes {
    player_id [name: 'idx_auth_session_player']
    external_identity_id [name: 'idx_auth_session_external_identity']
    expires_at [name: 'idx_auth_session_expiry']
    (player_id, revoked_at) [name: 'idx_auth_session_player_revoked']
  }

  checks {
    `expires_at > issued_at` [name: 'chk_auth_session_expiry']
    `revoked_at IS NULL OR revoked_at >= issued_at` [name: 'chk_auth_session_revoked_time']
    `(authentication_method <> 'google_oidc') OR external_identity_id IS NOT NULL` [name: 'chk_auth_session_google_identity']
    `(custodial_signing_eligible AND hive_signing_provider = 'custodial_service' AND hive_control_state_at_issue = 'platform_custodial') OR (NOT custodial_signing_eligible AND (hive_signing_provider IS NULL OR hive_signing_provider <> 'custodial_service'))` [name: 'chk_auth_session_custodial_signer']
  }

  Note: 'Authentication and Hive signing are independent. This table contains only a hash of the game refresh token—never Google tokens or Hive keys—and exists only after a playable player exists. Migration adds a partial unique index on player_id WHERE revoked_at IS NULL.'
}

Table identity.player_preference {
  player_id uuid [pk, not null]
  streamer_mode boolean [not null, default: false]
  ui_scale numeric(4,2) [not null, default: 1.00]
  colorblind_mode identity.colorblind_mode [not null, default: 'none']
  crosshair_config jsonb [not null, default: '{}']
  master_volume numeric(4,3) [not null, default: 1.000]
  effects_volume numeric(4,3) [not null, default: 1.000]
  interface_volume numeric(4,3) [not null, default: 1.000]
  ~mutable_record
  ~optimistic_lock

  checks {
    `ui_scale BETWEEN 0.50 AND 2.00` [name: 'chk_player_preference_ui_scale']
    `master_volume BETWEEN 0 AND 1` [name: 'chk_player_preference_master_volume']
    `effects_volume BETWEEN 0 AND 1` [name: 'chk_player_preference_effects_volume']
    `interface_volume BETWEEN 0 AND 1` [name: 'chk_player_preference_interface_volume']
  }
}

Table identity.player_platform_setting {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  player_id uuid [not null]
  platform identity.client_platform [not null]
  mouse_sensitivity numeric(8,4)
  controller_sensitivity numeric(8,4)
  control_mapping jsonb [not null, default: '{}']
  ~mutable_record
  ~optimistic_lock

  indexes {
    (player_id, platform) [unique, name: 'uq_player_platform_setting']
  }

  checks {
    `mouse_sensitivity IS NULL OR mouse_sensitivity > 0` [name: 'chk_platform_mouse_sensitivity']
    `controller_sensitivity IS NULL OR controller_sensitivity > 0` [name: 'chk_platform_controller_sensitivity']
  }
}

Table identity.player_appearance {
  player_id uuid [pk, not null]
  character_form identity.character_form [not null, default: 'humanoid']
  size_preset identity.character_size_preset [not null, default: 'x1_0']
  lobby_pose_code varchar(64) [not null, default: 'neutral']
  paint_object_key text
  paint_sha256 char(64)
  appearance_format_version smallint [not null, default: 1]
  updated_at timestamptz [not null, default: `now()`]
  ~optimistic_lock

  checks {
    `character_form <> 'cube' OR size_preset = 'x1_0'` [name: 'chk_appearance_cube_size']
    `(paint_object_key IS NULL) = (paint_sha256 IS NULL)` [name: 'chk_appearance_paint_pair']
    `appearance_format_version > 0` [name: 'chk_appearance_format_version']
  }
}

Table identity.platform_role_approval {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  target_player_id uuid [not null]
  role identity.platform_role [not null]
  scope_type identity.role_scope_type [not null, default: 'platform']
  scope_id uuid
  valid_from timestamptz [not null]
  valid_until timestamptz
  requested_by_player_id uuid [not null]
  approved_by_player_id uuid
  state identity.role_approval_state [not null, default: 'pending']
  reason text [not null]
  requested_at timestamptz [not null, default: `now()`]
  expires_at timestamptz [not null]
  decided_at timestamptz

  indexes {
    (target_player_id, role, state) [name: 'idx_platform_role_approval_target']
    (requested_by_player_id, requested_at) [name: 'idx_platform_role_approval_requester']
    (approved_by_player_id, decided_at) [name: 'idx_platform_role_approval_approver']
    (state, expires_at) [name: 'idx_platform_role_approval_pending']
  }

  checks {
    `(scope_type = 'platform' AND scope_id IS NULL) OR (scope_type <> 'platform' AND scope_id IS NOT NULL)` [name: 'chk_platform_role_approval_scope']
    `valid_until IS NULL OR valid_until > valid_from` [name: 'chk_platform_role_approval_validity']
    `expires_at > requested_at` [name: 'chk_platform_role_approval_expiry']
    `approved_by_player_id IS NULL OR approved_by_player_id <> requested_by_player_id` [name: 'chk_platform_role_approval_separation']
    `(state <> 'approved') OR (approved_by_player_id IS NOT NULL AND decided_at IS NOT NULL)` [name: 'chk_platform_role_approval_approved']
    `(state NOT IN ('rejected', 'cancelled')) OR decided_at IS NOT NULL` [name: 'chk_platform_role_approval_decided']
  }

  Note: 'Two-person evidence for high-risk platform-role grants or extensions. Scope existence and agreement with the resulting assignment are enforced by migration triggers.'
}

Table identity.platform_role_assignment {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  player_id uuid [not null]
  role identity.platform_role [not null]
  scope_type identity.role_scope_type [not null, default: 'platform']
  scope_id uuid
  valid_from timestamptz [not null, default: `now()`]
  valid_until timestamptz
  granted_by_player_id uuid [not null]
  approval_id uuid [unique]
  grant_audit_event_id uuid [not null, unique]
  reason text [not null]
  revoked_at timestamptz
  revoked_by_player_id uuid
  revocation_reason text
  revocation_audit_event_id uuid [unique]
  ~created_record

  indexes {
    (player_id, role, valid_from) [name: 'idx_platform_role_assignment_player']
    (role, valid_until) [name: 'idx_platform_role_assignment_role']
    (granted_by_player_id, created_at) [name: 'idx_platform_role_assignment_granter']
    (revoked_by_player_id, revoked_at) [name: 'idx_platform_role_assignment_revoker']
  }

  checks {
    `(scope_type = 'platform' AND scope_id IS NULL) OR (scope_type <> 'platform' AND scope_id IS NOT NULL)` [name: 'chk_platform_role_assignment_scope']
    `valid_until IS NULL OR valid_until > valid_from` [name: 'chk_platform_role_assignment_validity']
    `player_id <> granted_by_player_id` [name: 'chk_platform_role_assignment_no_self_grant']
    `revoked_at IS NULL OR revoked_at >= valid_from` [name: 'chk_platform_role_assignment_revocation_time']
    `(revoked_at IS NULL AND revoked_by_player_id IS NULL AND revocation_reason IS NULL AND revocation_audit_event_id IS NULL) OR (revoked_at IS NOT NULL AND revoked_by_player_id IS NOT NULL AND revocation_reason IS NOT NULL AND revocation_audit_event_id IS NOT NULL)` [name: 'chk_platform_role_assignment_revocation']
  }

  Note: 'Only staff/operator platform roles are assigned here. Player, lobby-host, map-creator, pending identity, and service capabilities remain derived from their owning boundaries.'
}

Table identity.authorization_audit_event {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  actor_type identity.authorization_actor_type [not null]
  actor_player_id uuid
  actor_service_name varchar(128)
  decision identity.authorization_decision [not null]
  action varchar(128) [not null]
  resource_type varchar(128)
  resource_id uuid
  subject_player_id uuid
  role identity.platform_role
  scope_type identity.role_scope_type
  scope_id uuid
  correlation_id uuid [not null]
  reason_code varchar(128) [not null]
  metadata jsonb [not null, default: '{}']
  occurred_at timestamptz [not null, default: `now()`]

  indexes {
    (actor_player_id, occurred_at) [name: 'idx_authorization_audit_actor']
    (actor_service_name, occurred_at) [name: 'idx_authorization_audit_service']
    (subject_player_id, occurred_at) [name: 'idx_authorization_audit_subject']
    (decision, action, occurred_at) [name: 'idx_authorization_audit_decision']
    correlation_id [name: 'idx_authorization_audit_correlation']
  }

  checks {
    `(actor_type = 'player' AND actor_player_id IS NOT NULL AND actor_service_name IS NULL) OR (actor_type = 'service' AND actor_player_id IS NULL AND actor_service_name IS NOT NULL)` [name: 'chk_authorization_audit_actor']
    `(scope_type IS NULL AND scope_id IS NULL) OR (scope_type = 'platform' AND scope_id IS NULL) OR (scope_type IN ('map', 'tournament') AND scope_id IS NOT NULL)` [name: 'chk_authorization_audit_scope']
  }

  Note: 'Append-only, non-secret authorization evidence. Production retention is at least 180 days.'
}

Table social.friend_request {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  requester_player_id uuid [not null]
  recipient_player_id uuid [not null]
  status social.friend_request_status [not null, default: 'pending']
  sent_at timestamptz [not null, default: `now()`]
  responded_at timestamptz
  expires_at timestamptz

  indexes {
    (recipient_player_id, status, sent_at) [name: 'idx_friend_request_recipient']
    (requester_player_id, status, sent_at) [name: 'idx_friend_request_requester']
  }

  checks {
    `requester_player_id <> recipient_player_id` [name: 'chk_friend_request_not_self']
    `responded_at IS NULL OR responded_at >= sent_at` [name: 'chk_friend_request_response_time']
    `expires_at IS NULL OR expires_at > sent_at` [name: 'chk_friend_request_expiry']
  }

  Note: 'Migration adds an expression/partial unique index preventing reversed duplicate pending requests.'
}

Table social.friendship {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  player_low_id uuid [not null]
  player_high_id uuid [not null]
  source_request_id uuid [unique]
  accepted_at timestamptz [not null]

  indexes {
    (player_low_id, player_high_id) [unique, name: 'uq_friendship_pair']
    player_high_id [name: 'idx_friendship_high']
  }

  checks {
    `player_low_id < player_high_id` [name: 'chk_friendship_canonical_pair']
  }
}

Table social.player_block {
  blocker_player_id uuid [not null]
  blocked_player_id uuid [not null]
  blocked_at timestamptz [not null, default: `now()`]

  indexes {
    (blocker_player_id, blocked_player_id) [pk]
    blocked_player_id [name: 'idx_player_block_blocked']
  }

  checks {
    `blocker_player_id <> blocked_player_id` [name: 'chk_player_block_not_self']
  }
}

Table social.lobby_invitation {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  lobby_id uuid [not null]
  inviter_player_id uuid [not null]
  invitee_player_id uuid [not null]
  status social.invitation_status [not null, default: 'pending']
  created_at timestamptz [not null, default: `now()`]
  expires_at timestamptz [not null]
  responded_at timestamptz

  indexes {
    (invitee_player_id, status, expires_at) [name: 'idx_lobby_invitation_inbox']
    (lobby_id, status) [name: 'idx_lobby_invitation_lobby']
    inviter_player_id [name: 'idx_lobby_invitation_inviter']
  }

  checks {
    `inviter_player_id <> invitee_player_id` [name: 'chk_lobby_invitation_not_self']
    `expires_at > created_at` [name: 'chk_lobby_invitation_expiry']
    `responded_at IS NULL OR responded_at >= created_at` [name: 'chk_lobby_invitation_response_time']
  }

  Note: 'Migration adds a partial unique index on lobby_id and invitee_player_id WHERE status is pending.'
}

Table social.notification {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  recipient_player_id uuid [not null]
  notification_type varchar(64) [not null]
  payload jsonb [not null, default: '{}']
  related_entity_type varchar(64)
  related_entity_id uuid
  created_at timestamptz [not null, default: `now()`]
  read_at timestamptz
  expires_at timestamptz

  indexes {
    (recipient_player_id, read_at, created_at) [name: 'idx_notification_inbox']
    expires_at [name: 'idx_notification_expiry']
  }

  checks {
    `read_at IS NULL OR read_at >= created_at` [name: 'chk_notification_read_time']
    `expires_at IS NULL OR expires_at > created_at` [name: 'chk_notification_expiry']
  }
}

Table game.lobby {
  id uuid [pk, not null, note: 'Application-generated UUIDv7; one complete lobby lifecycle']
  name varchar(128) [not null]
  current_host_player_id uuid [not null]
  visibility game.lobby_visibility [not null, default: 'public']
  password_hash text
  max_players smallint [not null, default: 10]
  region_code varchar(32) [not null]
  created_at timestamptz [not null, default: `now()`]
  closed_at timestamptz
  ~optimistic_lock

  indexes {
    (region_code, visibility, closed_at) [name: 'idx_lobby_discovery']
    current_host_player_id [name: 'idx_lobby_current_host']
  }

  checks {
    `max_players BETWEEN 2 AND 10` [name: 'chk_lobby_max_players']
    `(visibility = 'public' AND password_hash IS NULL) OR (visibility = 'private' AND password_hash IS NOT NULL)` [name: 'chk_lobby_password_policy']
    `closed_at IS NULL OR closed_at >= created_at` [name: 'chk_lobby_closed_time']
  }

  Note: 'Current host is a fast pointer synchronized transactionally with lobby_host_assignment. Migration adds a partial discovery index WHERE closed_at IS NULL.'
}

Table game.lobby_access_token {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  lobby_id uuid [not null]
  created_by_player_id uuid [not null]
  token_hash char(64) [not null, unique]
  created_at timestamptz [not null, default: `now()`]
  expires_at timestamptz [not null]
  revoked_at timestamptz

  indexes {
    (lobby_id, expires_at) [name: 'idx_lobby_access_token_lobby']
    created_by_player_id [name: 'idx_lobby_access_token_creator']
  }

  checks {
    `expires_at > created_at` [name: 'chk_lobby_access_token_expiry']
    `revoked_at IS NULL OR revoked_at >= created_at` [name: 'chk_lobby_access_token_revoked']
  }
}

Table game.lobby_membership {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  lobby_id uuid [not null]
  player_id uuid [not null]
  join_source game.lobby_join_source [not null]
  initially_spectator boolean [not null, default: false]
  hunter_nominated boolean [not null, default: false, note: 'Durable until consumed transactionally at round start']
  joined_at timestamptz [not null, default: `now()`]
  left_at timestamptz

  indexes {
    (lobby_id, joined_at) [name: 'idx_lobby_membership_lobby']
    (player_id, joined_at) [name: 'idx_lobby_membership_player']
  }

  checks {
    `left_at IS NULL OR left_at >= joined_at` [name: 'chk_lobby_membership_left_time']
  }

  Note: 'Migration adds a partial unique index on player_id WHERE left_at IS NULL. Pre-round Hunter nomination survives match-handler restarts; runtime presence and reconnect reservation remain in Nakama/Redis.'
}

Table game.lobby_host_assignment {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  lobby_id uuid [not null]
  host_player_id uuid [not null]
  reason game.host_assignment_reason [not null]
  started_at timestamptz [not null, default: `now()`]
  ended_at timestamptz

  indexes {
    (lobby_id, started_at) [name: 'idx_lobby_host_history']
    host_player_id [name: 'idx_lobby_host_player']
  }

  checks {
    `ended_at IS NULL OR ended_at >= started_at` [name: 'chk_lobby_host_assignment_time']
  }

  Note: 'Migration adds a partial unique index on lobby_id WHERE ended_at IS NULL.'
}

Table game.lobby_configuration {
  lobby_id uuid [pk, not null]
  mode game.game_mode [not null, default: 'casual']
  map_version_id uuid
  hunter_count smallint [not null, default: 1]
  hiding_duration_seconds integer [not null]
  hunting_duration_seconds integer [not null]
  taunt_enabled boolean [not null, default: true]
  taunt_interval_seconds integer
  shell_limit integer [not null]
  reload_duration_ms integer [not null]
  auto_start_enabled boolean [not null, default: true]
  auto_start_threshold smallint [not null, default: 7]
  updated_at timestamptz [not null, default: `now()`]
  ~optimistic_lock

  indexes {
    map_version_id [name: 'idx_lobby_configuration_map']
  }

  checks {
    `hunter_count BETWEEN 1 AND 2` [name: 'chk_lobby_configuration_hunters']
    `hiding_duration_seconds > 0` [name: 'chk_lobby_configuration_hiding_time']
    `hunting_duration_seconds > 0` [name: 'chk_lobby_configuration_hunting_time']
    `shell_limit > 0` [name: 'chk_lobby_configuration_shell_limit']
    `reload_duration_ms > 0` [name: 'chk_lobby_configuration_reload']
    `auto_start_threshold BETWEEN 2 AND 10` [name: 'chk_lobby_configuration_auto_start']
    `(NOT taunt_enabled) OR (taunt_interval_seconds IS NOT NULL AND taunt_interval_seconds > 0)` [name: 'chk_lobby_configuration_taunt']
  }
}

Table game.game_round {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  lobby_id uuid [not null]
  sequence_number integer [not null]
  mode game.game_mode [not null]
  map_version_id uuid [not null]
  hunter_count smallint [not null]
  hiding_duration_seconds integer [not null]
  hunting_duration_seconds integer [not null]
  taunt_enabled boolean [not null]
  taunt_interval_seconds integer
  shell_limit integer [not null]
  reload_duration_ms integer [not null]
  auto_start_enabled boolean [not null]
  auto_start_threshold smallint [not null]
  rule_schema_version smallint [not null, default: 1]
  additional_rule_snapshot jsonb [not null, default: '{}']
  game_server_build_version varchar(64) [not null]
  protocol_version varchar(32) [not null]
  status game.round_status [not null]
  winning_side game.winning_side
  result_schema_version varchar(32) [not null]
  scoring_rule_version varchar(32) [not null]
  canonical_result_sha256 char(64)
  started_at timestamptz [not null]
  ended_at timestamptz
  abort_reason text
  ~created_record

  indexes {
    (lobby_id, sequence_number) [unique, name: 'uq_game_round_lobby_sequence']
    (status, started_at) [name: 'idx_game_round_status_time']
    (map_version_id, started_at) [name: 'idx_game_round_map_time']
  }

  checks {
    `sequence_number > 0` [name: 'chk_game_round_sequence']
    `hunter_count BETWEEN 1 AND 2` [name: 'chk_game_round_hunters']
    `hiding_duration_seconds > 0 AND hunting_duration_seconds > 0` [name: 'chk_game_round_times']
    `(NOT taunt_enabled) OR (taunt_interval_seconds IS NOT NULL AND taunt_interval_seconds > 0)` [name: 'chk_game_round_taunt']
    `shell_limit > 0 AND reload_duration_ms > 0` [name: 'chk_game_round_weapon_rules']
    `rule_schema_version > 0` [name: 'chk_game_round_rule_version']
    `(status <> 'aborted') OR (ended_at IS NOT NULL AND abort_reason IS NOT NULL AND winning_side IS NULL)` [name: 'chk_game_round_aborted']
    `(status <> 'completed') OR (ended_at IS NOT NULL AND winning_side IS NOT NULL AND canonical_result_sha256 IS NOT NULL)` [name: 'chk_game_round_completed']
  }

  Note: 'Completed round rows and detailed result children are immutable through service policy and migration triggers. Later public corrections or invalidations append round_result_revision rows and never edit this result.'
}

Table game.round_participant {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  round_id uuid [not null]
  player_id uuid [not null]
  hunter_volunteer boolean [not null, default: false]
  initial_role game.player_role [not null]
  final_role game.player_role [not null]
  character_form identity.character_form [not null]
  size_preset identity.character_size_preset [not null]
  outcome game.participant_outcome [not null]
  survival_duration_ms bigint
  final_score numeric(18,4)
  score_breakdown jsonb [not null, default: '{}']
  found_or_converted_at timestamptz
  reconnected boolean [not null, default: false]
  ~created_record

  indexes {
    (round_id, player_id) [unique, name: 'uq_round_participant_player']
    (player_id, created_at) [name: 'idx_round_participant_history']
  }

  checks {
    `character_form <> 'cube' OR size_preset = 'x1_0'` [name: 'chk_round_participant_cube_size']
    `survival_duration_ms IS NULL OR survival_duration_ms >= 0` [name: 'chk_round_participant_survival']
  }

  Note: 'Inserted as terminal result data when a round completes; live participant roles and state remain in the authoritative match runtime.'
}

Table game.round_discovery {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  round_id uuid [not null]
  hunter_player_id uuid [not null]
  hider_player_id uuid [not null]
  discovery_sequence smallint [not null]
  occurred_at timestamptz [not null]
  caused_infection_conversion boolean [not null, default: false]

  indexes {
    (round_id, discovery_sequence) [unique, name: 'uq_round_discovery_sequence']
    (round_id, hider_player_id) [unique, name: 'uq_round_discovery_hider']
    (round_id, hunter_player_id) [name: 'idx_round_discovery_round_hunter']
    hunter_player_id [name: 'idx_round_discovery_hunter']
  }

  checks {
    `hunter_player_id <> hider_player_id` [name: 'chk_round_discovery_distinct_players']
    `discovery_sequence > 0` [name: 'chk_round_discovery_sequence']
  }
}

Table game.round_disguise_snapshot {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  round_participant_id uuid [not null, unique]
  object_storage_key text [not null]
  sha256 char(64) [not null]
  format_version smallint [not null, default: 1]
  captured_at timestamptz [not null]

  checks {
    `format_version > 0` [name: 'chk_round_disguise_format']
  }
}

Table game.round_like {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  round_id uuid [not null]
  voter_player_id uuid [not null]
  target_hider_player_id uuid [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (round_id, voter_player_id) [unique, name: 'uq_round_like_voter']
    (round_id, target_hider_player_id) [name: 'idx_round_like_target']
    voter_player_id [name: 'idx_round_like_voter_player']
  }

  checks {
    `voter_player_id <> target_hider_player_id` [name: 'chk_round_like_not_self']
  }

  Note: 'Composite FK guarantees target participated in the same round; service verifies target was a Hider and voter was eligible.'
}

Table game.round_result_revision {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  round_id uuid [not null]
  revision_number integer [not null]
  revision_type game.round_result_revision_type [not null]
  previous_revision_id uuid [unique]
  result_schema_version varchar(32) [not null]
  scoring_rule_version varchar(32) [not null]
  canonical_complete_result_sha256 char(64)
  canonical_result_object_key text
  reason_code varchar(64)
  ~created_record

  indexes {
    (round_id, revision_number) [unique, name: 'uq_round_result_revision_number']
    (id, round_id) [unique, name: 'uq_round_result_revision_round']
    (round_id, revision_type, created_at) [name: 'idx_round_result_revision_history']
  }

  checks {
    `revision_number > 0` [name: 'chk_round_result_revision_number']
    `(revision_type <> 'initial') OR (revision_number = 1 AND previous_revision_id IS NULL AND reason_code IS NULL AND canonical_complete_result_sha256 IS NOT NULL AND canonical_result_object_key IS NOT NULL)` [name: 'chk_round_result_revision_initial']
    `(revision_type <> 'correction') OR (previous_revision_id IS NOT NULL AND reason_code IS NOT NULL AND canonical_complete_result_sha256 IS NOT NULL AND canonical_result_object_key IS NOT NULL)` [name: 'chk_round_result_revision_correction']
    `(revision_type <> 'invalidation') OR (previous_revision_id IS NOT NULL AND reason_code IS NOT NULL AND canonical_complete_result_sha256 IS NULL AND canonical_result_object_key IS NULL)` [name: 'chk_round_result_revision_invalidation']
  }

  Note: 'Append-only local result history. previous_revision_id is unique to keep the chain linear; a migration trigger also requires the previous row to belong to the same round and revision_number to advance by one. The initial revision is committed with the terminal detailed result and matches game_round versions/hash.'
}

Table game.match_publication_request {
  id uuid [pk, not null, note: 'Application-generated UUIDv7; stable publication request']
  round_id uuid [not null]
  result_revision_id uuid [not null, unique]
  request_type game.match_publication_request_type [not null]
  state game.match_publication_request_state [not null, default: 'queued']
  attempt_count integer [not null, default: 0]
  next_retry_at timestamptz
  last_attempt_at timestamptz
  last_failure_code varchar(64)
  published_at timestamptz
  ~mutable_record

  indexes {
    (state, next_retry_at) [name: 'idx_match_publication_request_retry']
    (round_id, request_type, state) [name: 'idx_match_publication_request_round']
  }

  checks {
    `attempt_count >= 0` [name: 'chk_match_publication_request_attempts']
    `(state <> 'published') OR published_at IS NOT NULL` [name: 'chk_match_publication_request_published']
  }

  Note: 'The initial request is inserted in the same database transaction as the completed round, detailed rows, and initial result revision. Migration enforces type agreement with the revision and one noncancelled initial request per round.'
}

Table game.match_publication_outbox {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  event_uuid uuid [not null, unique, note: 'Stable protocol UUIDv7 across retries']
  batch_uuid uuid [unique, note: 'Stable logical batch UUIDv7 across retries; initial batches only']
  event_type hive_projection.match_event_type [not null]
  schema_version smallint [not null]
  event_contract_version varchar(32) [not null]
  publication_period_start timestamptz
  publication_period_end timestamptz
  publisher_hive_account varchar(16) [not null]
  result_count smallint [not null]
  canonical_payload text [not null]
  parsed_payload jsonb [not null]
  payload_sha256 char(64) [not null]
  payload_byte_count integer [not null]
  state game.match_publication_outbox_state [not null, default: 'queued']
  attempt_count integer [not null, default: 0]
  next_retry_at timestamptz
  last_attempt_at timestamptz
  last_failure_code varchar(64)
  hive_transaction_id varchar(128)
  operation_id uuid [unique]
  included_at timestamptz
  irreversible_at timestamptz
  reverted_at timestamptz
  ~mutable_record

  indexes {
    (state, next_retry_at) [name: 'idx_match_outbox_retry']
    (event_type, created_at) [name: 'idx_match_outbox_event_type']
    (publisher_hive_account, state) [name: 'idx_match_outbox_publisher']
    hive_transaction_id [name: 'idx_match_outbox_transaction']
  }

  checks {
    `schema_version > 0` [name: 'chk_match_outbox_schema_version']
    `(event_type = 'match_results_batch' AND batch_uuid IS NOT NULL AND publication_period_start IS NOT NULL AND publication_period_end IS NOT NULL AND publication_period_end >= publication_period_start) OR (event_type <> 'match_results_batch' AND batch_uuid IS NULL AND publication_period_start IS NULL AND publication_period_end IS NULL AND result_count = 1)` [name: 'chk_match_outbox_event_shape']
    `publisher_hive_account = lower(publisher_hive_account)` [name: 'chk_match_outbox_publisher_lower']
    `result_count > 0` [name: 'chk_match_outbox_result_count']
    `payload_byte_count > 0 AND octet_length(canonical_payload) = payload_byte_count` [name: 'chk_match_outbox_payload_size']
    `attempt_count >= 0` [name: 'chk_match_outbox_attempts']
    `(state <> 'included') OR (hive_transaction_id IS NOT NULL AND operation_id IS NOT NULL AND included_at IS NOT NULL)` [name: 'chk_match_outbox_included']
    `(state <> 'irreversible') OR (operation_id IS NOT NULL AND irreversible_at IS NOT NULL)` [name: 'chk_match_outbox_irreversible']
    `(state <> 'reverted') OR (operation_id IS NOT NULL AND reverted_at IS NOT NULL)` [name: 'chk_match_outbox_reverted']
  }

  Note: 'Operational outbox, not the HAF projection. canonical_payload is the exact immutable application payload used across retries; parsed_payload is validated query data. Initial events carry a stable batch UUID and period; correction/invalidation events are single-result events and carry their original-batch lineage inside the event payload/change projection. Initial batching defaults to five minutes, 20 results, or 6 KiB, whichever is reached first; only production tuning is open. A retry may rebuild transaction headers but not logical IDs or payload bytes/hash.'
}

Table game.match_publication_item {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  outbox_id uuid [not null]
  publication_request_id uuid [not null, unique]
  round_id uuid [not null]
  result_revision_id uuid [not null]
  result_position smallint [not null]
  ~created_record

  indexes {
    (outbox_id, result_position) [unique, name: 'uq_match_publication_item_position']
    (result_revision_id, round_id) [name: 'idx_match_publication_item_revision']
    (round_id, outbox_id) [name: 'idx_match_publication_item_round']
  }

  checks {
    `result_position >= 0` [name: 'chk_match_publication_item_position']
  }

  Note: 'Links durable requests to one immutable payload. Migrations verify request/revision/round/type consistency, enforce one item for correction/invalidation events, and enforce item count/positions against outbox.result_count.'
}

Table game.player_mode_stat {
  player_id uuid [not null]
  mode game.game_mode [not null]
  rounds_played bigint [not null, default: 0]
  hunter_wins bigint [not null, default: 0]
  hider_wins bigint [not null, default: 0]
  discoveries bigint [not null, default: 0]
  times_survived bigint [not null, default: 0]
  infection_conversions bigint [not null, default: 0]
  likes_given bigint [not null, default: 0]
  likes_received bigint [not null, default: 0]
  aggregate_score numeric(24,4) [not null, default: 0]
  last_recalculated_at timestamptz [not null]

  indexes {
    (player_id, mode) [pk]
  }

  checks {
    `rounds_played >= 0 AND hunter_wins >= 0 AND hider_wins >= 0` [name: 'chk_player_mode_stat_rounds']
    `discoveries >= 0 AND times_survived >= 0 AND infection_conversions >= 0` [name: 'chk_player_mode_stat_performance']
    `likes_given >= 0 AND likes_received >= 0` [name: 'chk_player_mode_stat_likes']
  }

  Note: 'Rebuildable cache; round history remains authoritative.'
}

Table game.achievement_definition {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  code varchar(128) [not null, unique]
  display_name varchar(128) [not null]
  description text [not null]
  criteria_version smallint [not null, default: 1]
  criteria jsonb [not null, default: '{}']
  badge_collectible_definition_id uuid
  active boolean [not null, default: true]
  ~mutable_record

  indexes {
    badge_collectible_definition_id [name: 'idx_achievement_badge_definition']
  }

  checks {
    `criteria_version > 0` [name: 'chk_achievement_criteria_version']
  }
}

Table game.player_achievement {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  player_id uuid [not null]
  achievement_definition_id uuid [not null]
  status game.achievement_status [not null, default: 'in_progress']
  progress_value numeric(20,4) [not null, default: 0]
  progress jsonb [not null, default: '{}']
  earned_at timestamptz
  award_correlation_id uuid [unique]
  badge_collectible_instance_id uuid [unique]
  ~mutable_record

  indexes {
    (player_id, achievement_definition_id) [unique, name: 'uq_player_achievement']
    achievement_definition_id [name: 'idx_player_achievement_definition']
    (status, earned_at) [name: 'idx_player_achievement_status']
  }

  checks {
    `progress_value >= 0` [name: 'chk_player_achievement_progress']
    `(status <> 'earned') OR earned_at IS NOT NULL` [name: 'chk_player_achievement_earned']
  }
}

Table content.map {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  origin content.map_origin [not null]
  creator_player_id uuid
  slug varchar(120) [not null, unique]
  title varchar(120) [not null]
  description text [not null]
  lifecycle content.map_lifecycle [not null, default: 'draft']
  cached_play_count bigint [not null, default: 0]
  ~mutable_record
  ~optimistic_lock

  indexes {
    (lifecycle, origin) [name: 'idx_map_discovery']
    (creator_player_id, created_at) [name: 'idx_map_creator']
  }

  checks {
    `origin <> 'community' OR creator_player_id IS NOT NULL` [name: 'chk_map_community_creator']
    `cached_play_count >= 0` [name: 'chk_map_play_count']
    `slug = lower(slug)` [name: 'chk_map_slug_lower']
  }
}

Table content.map_version {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  map_id uuid [not null]
  version_number varchar(32) [not null]
  manifest jsonb [not null, default: '{}']
  status content.map_version_status [not null, default: 'draft']
  license_declaration_version varchar(32) [not null]
  license_accepted_at timestamptz [not null]
  technical_validation jsonb [not null, default: '{}']
  submitted_at timestamptz
  approved_at timestamptz
  published_at timestamptz
  suspended_at timestamptz
  ~mutable_record
  ~optimistic_lock

  indexes {
    (map_id, version_number) [unique, name: 'uq_map_version_number']
    (id, map_id) [unique, name: 'uq_map_version_id_map']
    (map_id, status) [name: 'idx_map_version_map_status']
    (status, published_at) [name: 'idx_map_version_publication']
  }

  checks {
    `license_accepted_at >= created_at` [name: 'chk_map_version_license_time']
    `submitted_at IS NULL OR submitted_at >= created_at` [name: 'chk_map_version_submission_time']
    `approved_at IS NULL OR submitted_at IS NOT NULL` [name: 'chk_map_version_approval_requires_submission']
    `published_at IS NULL OR approved_at IS NOT NULL` [name: 'chk_map_version_publish_requires_approval']
  }

  Note: 'After submission, version identity, manifest, package, and asset content are immutable; controlled review/status timestamps may advance. Package location/hash/size are stored once in map_asset(kind=package).'
}

Table content.map_lifecycle_event {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  map_id uuid [not null]
  map_version_id uuid
  previous_lifecycle content.map_lifecycle
  new_lifecycle content.map_lifecycle [not null]
  reason_code varchar(64)
  creator_message text
  internal_notes text
  changed_by_player_id uuid
  occurred_at timestamptz [not null, default: `now()`]

  indexes {
    (map_id, occurred_at) [name: 'idx_map_lifecycle_event_map']
    (new_lifecycle, occurred_at) [name: 'idx_map_lifecycle_event_state']
    (map_version_id, map_id) [name: 'idx_map_lifecycle_event_version']
    changed_by_player_id [name: 'idx_map_lifecycle_event_actor']
  }

  checks {
    `previous_lifecycle IS NULL OR previous_lifecycle <> new_lifecycle` [name: 'chk_map_lifecycle_event_change']
  }

  Note: 'Append-only lifecycle history. Suspension/removal requires a creator-facing reason through service validation; actor may be null for an automated system transition.'
}

Table content.map_asset {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  map_version_id uuid [not null]
  kind content.map_asset_kind [not null]
  object_storage_key text [not null, unique]
  media_type varchar(128) [not null]
  size_bytes bigint [not null]
  sha256 char(64) [not null]
  sort_order smallint [not null, default: 0]
  ~created_record

  indexes {
    (map_version_id, kind, sort_order) [unique, name: 'uq_map_asset_order']
  }

  checks {
    `size_bytes >= 0` [name: 'chk_map_asset_size']
    `sort_order >= 0` [name: 'chk_map_asset_sort_order']
  }

  Note: 'Migration adds a partial unique index enforcing one package asset per map version.'
}

Table content.map_review {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  map_version_id uuid [not null]
  reviewer_player_id uuid [not null]
  decision content.map_review_decision [not null]
  creator_feedback text
  internal_notes text
  reviewed_at timestamptz [not null, default: `now()`]

  indexes {
    (map_version_id, reviewed_at) [name: 'idx_map_review_version']
    (reviewer_player_id, reviewed_at) [name: 'idx_map_review_reviewer']
  }

  Note: 'Append-only review history. Authorization is defined by the separate roles and permissions design.'
}

Table content.tag {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  code varchar(64) [not null, unique]
  display_name varchar(64) [not null]
  ~created_record

  checks {
    `code = lower(code)` [name: 'chk_tag_code_lower']
  }
}

Table content.map_tag {
  map_id uuid [not null]
  tag_id uuid [not null]

  indexes {
    (map_id, tag_id) [pk]
    tag_id [name: 'idx_map_tag_tag']
  }
}

Table content.map_distribution {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  map_version_id uuid [not null]
  platform content.distribution_platform [not null]
  state content.distribution_state [not null, default: 'unavailable']
  required_game_build_version varchar(64) [not null]
  published_at timestamptz
  withdrawn_at timestamptz
  ~created_record

  indexes {
    (map_version_id, platform) [unique, name: 'uq_map_distribution_platform']
    (platform, state, required_game_build_version) [name: 'idx_map_distribution_availability']
  }

  checks {
    `(state = 'unavailable' AND published_at IS NULL AND withdrawn_at IS NULL) OR (state = 'available' AND published_at IS NOT NULL AND withdrawn_at IS NULL) OR (state = 'withdrawn' AND published_at IS NOT NULL AND withdrawn_at IS NOT NULL AND withdrawn_at >= published_at)` [name: 'chk_map_distribution_state_times']
  }
}

Table content.map_showcase {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  map_id uuid [not null]
  map_version_id uuid
  creator_player_id uuid [not null]
  community_post_id uuid [unique]
  state content.showcase_state [not null, default: 'draft']
  draft_title varchar(256)
  draft_body text
  draft_metadata jsonb [not null, default: '{}']
  published_at timestamptz
  last_hive_sync_at timestamptz
  ~mutable_record
  ~optimistic_lock

  indexes {
    (map_id, state) [name: 'idx_map_showcase_map']
    (map_version_id, map_id) [name: 'idx_map_showcase_version']
    (creator_player_id, created_at) [name: 'idx_map_showcase_creator']
  }

  Note: 'Hive projection is authoritative for published post/vote data. Migration may add a partial unique index for one active showcase per map version.'
}

Table commerce.collectible_definition {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  definition_code varchar(128) [not null, unique]
  kind commerce.collectible_kind [not null]
  display_name varchar(128) [not null]
  description text [not null]
  metadata_uri text [not null]
  metadata_sha256 char(64) [not null]
  availability commerce.collectible_availability [not null, default: 'draft']
  ~mutable_record

  indexes {
    (kind, availability) [name: 'idx_collectible_definition_catalog']
  }
}

Table commerce.collectible_asset {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  collectible_definition_id uuid [not null]
  asset_kind varchar(64) [not null]
  platform commerce.asset_platform [not null, default: 'all']
  object_storage_key text [not null, unique]
  media_type varchar(128) [not null]
  size_bytes bigint [not null]
  sha256 char(64) [not null]
  sort_order smallint [not null, default: 0]
  ~created_record

  indexes {
    (collectible_definition_id, asset_kind, platform, sort_order) [unique, name: 'uq_collectible_asset_order']
  }

  checks {
    `size_bytes >= 0` [name: 'chk_collectible_asset_size']
    `sort_order >= 0` [name: 'chk_collectible_asset_sort']
  }
}

Table commerce.collectible_instance {
  id uuid [pk, not null, note: 'Matches on-chain collectible UUIDv7']
  collectible_definition_id uuid [not null]
  owner_player_id uuid [not null]
  issuer_hive_account varchar(16) [not null]
  issuance_reason varchar(64) [not null]
  metadata_uri text [not null]
  metadata_sha256 char(64) [not null]
  state commerce.collectible_state [not null, default: 'pending']
  issued_event_id uuid [not null, unique]
  revoked_event_id uuid [unique]
  issued_hive_transaction_id varchar(128) [not null]
  issued_hive_block_number bigint [not null]
  irreversible_at timestamptz
  revoked_at timestamptz
  payment_transaction_id uuid [unique]
  ~created_record

  indexes {
    (owner_player_id, state) [name: 'idx_collectible_instance_owner']
    (collectible_definition_id, state) [name: 'idx_collectible_instance_definition']
    (issued_event_id, id, collectible_definition_id) [name: 'idx_collectible_instance_issued_event']
    (revoked_event_id, id, collectible_definition_id) [name: 'idx_collectible_instance_revoked_event']
  }

  checks {
    `issuer_hive_account = lower(issuer_hive_account)` [name: 'chk_collectible_instance_issuer_lower']
    `(state <> 'finalized') OR irreversible_at IS NOT NULL` [name: 'chk_collectible_instance_finalized']
    `(state <> 'revoked') OR (revoked_at IS NOT NULL AND revoked_event_id IS NOT NULL)` [name: 'chk_collectible_instance_revoked']
  }

  Note: 'Hive event history is authoritative. Owner is immutable; collectibles and badges are non-transferable.'
}

Table commerce.player_loadout {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  player_id uuid [not null]
  equipment_slot commerce.equipment_slot [not null]
  collectible_instance_id uuid [not null]
  equipped_at timestamptz [not null, default: `now()`]
  unequipped_at timestamptz

  indexes {
    (player_id, equipment_slot, equipped_at) [name: 'idx_player_loadout_history']
    (collectible_instance_id, equipped_at) [name: 'idx_player_loadout_collectible']
  }

  checks {
    `unequipped_at IS NULL OR unequipped_at >= equipped_at` [name: 'chk_player_loadout_unequipped']
  }

  Note: 'Migrations add partial unique indexes for one active row per player/slot and one active use per collectible. Service validates finalized ownership and slot compatibility.'
}

Table commerce.shop_offer {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  collectible_definition_id uuid [not null]
  state commerce.offer_state [not null, default: 'draft']
  starts_at timestamptz
  ends_at timestamptz
  purchase_limit_per_player integer
  total_purchase_limit integer
  ~mutable_record
  ~optimistic_lock

  indexes {
    collectible_definition_id [name: 'idx_shop_offer_definition']
    (state, starts_at, ends_at) [name: 'idx_shop_offer_availability']
  }

  checks {
    `starts_at IS NULL OR ends_at IS NULL OR ends_at > starts_at` [name: 'chk_shop_offer_window']
    `purchase_limit_per_player IS NULL OR purchase_limit_per_player > 0` [name: 'chk_shop_offer_player_limit']
    `total_purchase_limit IS NULL OR total_purchase_limit > 0` [name: 'chk_shop_offer_total_limit']
  }
}

Table commerce.shop_offer_price {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  shop_offer_id uuid [not null]
  payment_rail commerce.payment_rail [not null]
  asset_code varchar(16) [not null]
  amount numeric(20,8) [not null]
  ~created_record

  indexes {
    (shop_offer_id, payment_rail, asset_code) [unique, name: 'uq_shop_offer_price']
    (id, shop_offer_id) [unique, name: 'uq_shop_offer_price_offer_pair']
  }

  checks {
    `asset_code = upper(asset_code)` [name: 'chk_shop_offer_price_asset_upper']
    `amount > 0` [name: 'chk_shop_offer_price_amount']
  }
}

Table commerce.payment_transaction {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  player_id uuid [not null]
  direction commerce.payment_direction [not null]
  purpose commerce.payment_purpose [not null]
  rail commerce.payment_rail [not null]
  asset_code varchar(16) [not null]
  amount numeric(20,8) [not null]
  sender_reference varchar(128) [not null]
  recipient_reference varchar(128) [not null]
  external_transaction_id varchar(128)
  operation_index integer
  correlation_reference varchar(256)
  transaction_intent_id uuid [unique]
  state commerce.payment_state [not null, default: 'requested']
  requested_at timestamptz [not null, default: `now()`]
  included_at timestamptz
  irreversible_at timestamptz
  failed_at timestamptz
  provider_metadata jsonb [not null, default: '{}']
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (rail, external_transaction_id, operation_index) [unique, name: 'uq_payment_external_operation']
    (player_id, purpose, requested_at) [name: 'idx_payment_player_purpose']
    (state, requested_at) [name: 'idx_payment_state']
    correlation_reference [name: 'idx_payment_correlation']
  }

  checks {
    `asset_code = upper(asset_code)` [name: 'chk_payment_asset_upper']
    `amount > 0` [name: 'chk_payment_amount']
    `(external_transaction_id IS NULL) = (operation_index IS NULL)` [name: 'chk_payment_external_operation_pair']
    `(state <> 'irreversible') OR irreversible_at IS NOT NULL` [name: 'chk_payment_irreversible']
  }
}

Table commerce.purchase {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  player_id uuid [not null]
  shop_offer_id uuid [not null]
  shop_offer_price_id uuid [not null]
  payment_transaction_id uuid [unique]
  status commerce.purchase_status [not null, default: 'created']
  collectible_instance_id uuid [unique]
  created_at timestamptz [not null, default: `now()`]
  completed_at timestamptz
  failure_code varchar(64)

  indexes {
    (player_id, created_at) [name: 'idx_purchase_player']
    shop_offer_id [name: 'idx_purchase_offer']
    (shop_offer_price_id, shop_offer_id) [name: 'idx_purchase_price_offer']
    (status, created_at) [name: 'idx_purchase_status']
  }

  checks {
    `(status <> 'fulfilled') OR (payment_transaction_id IS NOT NULL AND collectible_instance_id IS NOT NULL AND completed_at IS NOT NULL)` [name: 'chk_purchase_fulfilled']
  }
}

Table tournament.tournament {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  name varchar(160) [not null]
  description text [not null]
  organizer_type tournament.organizer_type [not null]
  organizer_player_id uuid
  format tournament.tournament_format [not null]
  status tournament.tournament_status [not null, default: 'draft']
  max_players integer [not null]
  registration_opens_at timestamptz
  registration_closes_at timestamptz
  scheduled_start_at timestamptz
  entry_asset_code varchar(16) [not null]
  entry_amount numeric(20,8) [not null]
  treasury_hive_account varchar(16) [not null]
  rules_version smallint [not null, default: 1]
  rules jsonb [not null, default: '{}']
  started_at timestamptz
  completed_at timestamptz
  cancelled_at timestamptz
  ~mutable_record
  ~optimistic_lock

  indexes {
    (status, scheduled_start_at) [name: 'idx_tournament_status_start']
    (organizer_player_id, status) [name: 'idx_tournament_organizer']
  }

  checks {
    `organizer_type <> 'community' OR organizer_player_id IS NOT NULL` [name: 'chk_tournament_community_organizer']
    `max_players > 1` [name: 'chk_tournament_max_players']
    `entry_asset_code = upper(entry_asset_code)` [name: 'chk_tournament_entry_asset_upper']
    `entry_amount > 0` [name: 'chk_tournament_entry_amount']
    `treasury_hive_account = lower(treasury_hive_account)` [name: 'chk_tournament_treasury_lower']
    `rules_version > 0` [name: 'chk_tournament_rules_version']
    `registration_opens_at IS NULL OR registration_closes_at IS NULL OR registration_closes_at > registration_opens_at` [name: 'chk_tournament_registration_window']
    `registration_closes_at IS NULL OR scheduled_start_at IS NULL OR scheduled_start_at >= registration_closes_at` [name: 'chk_tournament_start_after_registration']
  }
}

Table tournament.tournament_entry {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  tournament_id uuid [not null]
  player_id uuid [not null]
  status tournament.entry_status [not null, default: 'pending_payment']
  entry_payment_transaction_id uuid [unique]
  registered_at timestamptz [not null, default: `now()`]
  checked_in_at timestamptz
  seed integer
  final_rank integer
  terminal_reason text
  completed_at timestamptz

  indexes {
    (tournament_id, player_id) [unique, name: 'uq_tournament_entry_player']
    (id, tournament_id) [unique, name: 'uq_tournament_entry_id_tournament']
    (tournament_id, status) [name: 'idx_tournament_entry_status']
    player_id [name: 'idx_tournament_entry_player']
  }

  checks {
    `seed IS NULL OR seed > 0` [name: 'chk_tournament_entry_seed']
    `final_rank IS NULL OR final_rank > 0` [name: 'chk_tournament_entry_rank']
  }
}

Table tournament.prize_rule {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  tournament_id uuid [not null]
  placement integer [not null]
  rule_type tournament.prize_rule_type [not null]
  percentage numeric(7,4)
  fixed_amount numeric(20,8)
  asset_code varchar(16) [not null]
  ~created_record

  indexes {
    (tournament_id, placement, asset_code) [unique, name: 'uq_tournament_prize_rule']
  }

  checks {
    `placement > 0` [name: 'chk_prize_rule_placement']
    `asset_code = upper(asset_code)` [name: 'chk_prize_rule_asset_upper']
    `(rule_type = 'percentage' AND percentage > 0 AND percentage <= 100 AND fixed_amount IS NULL) OR (rule_type = 'fixed' AND fixed_amount > 0 AND percentage IS NULL)` [name: 'chk_prize_rule_value']
  }
}

Table tournament.tournament_match {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  tournament_id uuid [not null]
  stage_number integer [not null]
  bracket_position integer
  sequence_number integer [not null]
  status tournament.match_status [not null, default: 'scheduled']
  scheduled_at timestamptz
  started_at timestamptz
  ended_at timestamptz
  winning_entry_id uuid
  result_version smallint [not null, default: 1]
  result_summary jsonb [not null, default: '{}']
  ~created_record

  indexes {
    (tournament_id, sequence_number) [unique, name: 'uq_tournament_match_sequence']
    (id, tournament_id) [unique, name: 'uq_tournament_match_id_tournament']
    (winning_entry_id, tournament_id) [name: 'idx_tournament_match_winner']
    (id, winning_entry_id) [name: 'idx_tournament_match_winner_entry']
    (tournament_id, stage_number, bracket_position) [name: 'idx_tournament_match_bracket']
  }

  checks {
    `stage_number > 0 AND sequence_number > 0` [name: 'chk_tournament_match_sequence']
    `bracket_position IS NULL OR bracket_position > 0` [name: 'chk_tournament_match_position']
    `result_version > 0` [name: 'chk_tournament_match_result_version']
    `ended_at IS NULL OR started_at IS NOT NULL` [name: 'chk_tournament_match_end_requires_start']
  }
}

Table tournament.match_entry {
  tournament_match_id uuid [not null]
  tournament_entry_id uuid [not null]
  tournament_id uuid [not null]
  seed_position integer
  outcome tournament.match_outcome
  score numeric(18,4)

  indexes {
    (tournament_match_id, tournament_entry_id) [pk]
    (tournament_match_id, tournament_id) [name: 'idx_match_entry_match_tournament']
    (tournament_entry_id, tournament_id) [name: 'idx_match_entry_entry_tournament']
    tournament_entry_id [name: 'idx_match_entry_entry']
  }

  checks {
    `seed_position IS NULL OR seed_position > 0` [name: 'chk_match_entry_seed']
  }
}

Table tournament.match_game_round {
  tournament_match_id uuid [not null]
  game_round_id uuid [not null, unique]
  round_sequence integer [not null]

  indexes {
    (tournament_match_id, game_round_id) [pk]
    (tournament_match_id, round_sequence) [unique, name: 'uq_match_game_round_sequence']
  }

  checks {
    `round_sequence > 0` [name: 'chk_match_game_round_sequence']
  }
}

Table tournament.entry_score {
  tournament_entry_id uuid [pk, not null]
  aggregate_score numeric(24,4) [not null, default: 0]
  wins integer [not null, default: 0]
  losses integer [not null, default: 0]
  rounds_played integer [not null, default: 0]
  last_recalculated_at timestamptz [not null]

  checks {
    `wins >= 0 AND losses >= 0 AND rounds_played >= 0` [name: 'chk_entry_score_counts']
  }

  Note: 'Rebuildable cache; tournament matches and game rounds remain authoritative.'
}

Table tournament.payout {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  tournament_id uuid [not null]
  tournament_entry_id uuid [not null]
  placement integer [not null]
  asset_code varchar(16) [not null]
  amount numeric(20,8) [not null]
  payment_transaction_id uuid [not null, unique]
  status tournament.payout_status [not null, default: 'pending']
  created_at timestamptz [not null, default: `now()`]
  processing_at timestamptz
  paid_at timestamptz
  failed_at timestamptz

  indexes {
    (tournament_id, status) [name: 'idx_tournament_payout_status']
    (tournament_entry_id, placement) [name: 'idx_tournament_payout_recipient']
    (tournament_entry_id, tournament_id) [name: 'idx_tournament_payout_entry']
  }

  checks {
    `placement > 0` [name: 'chk_tournament_payout_placement']
    `asset_code = upper(asset_code)` [name: 'chk_tournament_payout_asset_upper']
    `amount > 0` [name: 'chk_tournament_payout_amount']
    `(status <> 'paid') OR paid_at IS NOT NULL` [name: 'chk_tournament_payout_paid']
  }
}

Table hive_projection.block_checkpoint {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  source varchar(64) [not null]
  block_number bigint [not null]
  block_id varchar(128) [not null]
  previous_block_id varchar(128)
  block_timestamp timestamptz [not null]
  state hive_projection.operation_state [not null, default: 'included']
  observed_at timestamptz [not null, default: `now()`]
  irreversible_at timestamptz
  reverted_at timestamptz

  indexes {
    (source, block_id) [unique, name: 'uq_block_checkpoint_source_id']
    (source, block_number, block_id) [unique, name: 'uq_block_checkpoint_source_height_id']
    (source, block_number) [name: 'idx_block_checkpoint_source_height']
    (source, previous_block_id) [name: 'idx_block_checkpoint_parent']
    (source, state, block_number) [name: 'idx_block_checkpoint_state']
  }

  checks {
    `block_number >= 0` [name: 'chk_block_checkpoint_height']
    `(state <> 'irreversible') OR irreversible_at IS NOT NULL` [name: 'chk_block_checkpoint_irreversible']
    `(state <> 'reverted') OR reverted_at IS NOT NULL` [name: 'chk_block_checkpoint_reverted']
    `(state = 'included' AND irreversible_at IS NULL AND reverted_at IS NULL) OR (state = 'irreversible' AND irreversible_at IS NOT NULL AND reverted_at IS NULL) OR (state = 'reverted' AND irreversible_at IS NULL AND reverted_at IS NOT NULL)` [name: 'chk_block_checkpoint_state_evidence']
  }

  Note: 'Retains reversible and replaced branch evidence, including blocks with no relevant operations. Migration adds one non-reverted checkpoint per source/height and prevents reverting an irreversible checkpoint.'
}

Table hive_projection.operation {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  checkpoint_id uuid [not null]
  source_operation_id varchar(128) [not null, note: 'Stable HAF/HAfAH operation identity, including virtual operations']
  transaction_id varchar(128)
  operation_index integer [not null]
  is_virtual boolean [not null, default: false]
  block_number bigint [not null]
  block_id varchar(128) [not null]
  block_timestamp timestamptz [not null]
  operation_type varchar(64) [not null]
  primary_account varchar(16) [not null]
  required_authority hive_projection.authority_type
  application_id varchar(64)
  payload jsonb [not null]
  state hive_projection.operation_state [not null]
  validation_state hive_projection.validation_state [not null, default: 'pending']
  rejection_reason varchar(128)
  validated_at timestamptz
  observed_at timestamptz [not null, default: `now()`]
  irreversible_at timestamptz
  reverted_at timestamptz

  indexes {
    checkpoint_id [name: 'idx_hive_operation_checkpoint']
    source_operation_id [name: 'idx_hive_operation_source_id']
    (transaction_id, operation_index) [name: 'idx_hive_operation_tx_index']
    (block_number, operation_index) [name: 'idx_hive_operation_block']
    (block_number, block_id, state) [name: 'idx_hive_operation_replay']
    (operation_type, is_virtual, block_number) [name: 'idx_hive_operation_type']
    (application_id, block_number) [name: 'idx_hive_operation_application']
    (primary_account, block_timestamp) [name: 'idx_hive_operation_account']
  }

  checks {
    `operation_index >= 0 AND block_number >= 0` [name: 'chk_hive_operation_position']
    `is_virtual OR transaction_id IS NOT NULL` [name: 'chk_hive_operation_transaction_identity']
    `primary_account = lower(primary_account)` [name: 'chk_hive_operation_account_lower']
    `(state <> 'irreversible') OR irreversible_at IS NOT NULL` [name: 'chk_hive_operation_irreversible']
    `(state <> 'reverted') OR reverted_at IS NOT NULL` [name: 'chk_hive_operation_reverted']
    `(validation_state NOT IN ('accepted', 'rejected')) OR validated_at IS NOT NULL` [name: 'chk_hive_operation_validated']
    `(validation_state <> 'rejected') OR rejection_reason IS NOT NULL` [name: 'chk_hive_operation_rejection']
    `(state = 'included' AND irreversible_at IS NULL AND reverted_at IS NULL) OR (state = 'irreversible' AND irreversible_at IS NOT NULL AND reverted_at IS NULL) OR (state = 'reverted' AND irreversible_at IS NULL AND reverted_at IS NOT NULL)` [name: 'chk_hive_operation_state_evidence']
    `(validation_state = 'pending' AND validated_at IS NULL AND rejection_reason IS NULL) OR (validation_state = 'accepted' AND validated_at IS NOT NULL AND rejection_reason IS NULL) OR (validation_state = 'rejected' AND validated_at IS NOT NULL AND rejection_reason IS NOT NULL)` [name: 'chk_hive_operation_validation_evidence']
  }

  Note: 'Raw fork-aware operation evidence. Structurally malformed, unsupported, or unauthorized application operations remain here with a rejection reason and do not require a typed projection row.'
}

Table hive_projection.match_event {
  event_uuid uuid [pk, not null, note: 'Stable protocol UUIDv7']
  batch_uuid uuid [unique, note: 'Stable logical batch UUIDv7; initial batches only']
  operation_id uuid [not null, unique]
  event_type hive_projection.match_event_type [not null]
  schema_version smallint [not null]
  event_contract_version varchar(32) [not null]
  publication_period_start timestamptz
  publication_period_end timestamptz
  publisher_hive_account varchar(16) [not null]
  result_count smallint [not null]
  operation_state hive_projection.operation_state [not null]
  validation_state hive_projection.validation_state [not null, default: 'pending']
  rejection_reason varchar(128)
  included_at timestamptz [not null]
  irreversible_at timestamptz
  reverted_at timestamptz
  ~created_record

  indexes {
    (publisher_hive_account, included_at) [name: 'idx_match_event_publisher']
    (event_type, operation_state, included_at) [name: 'idx_match_event_state']
    (validation_state, created_at) [name: 'idx_match_event_validation']
  }

  checks {
    `schema_version > 0` [name: 'chk_match_event_schema_version']
    `(event_type = 'match_results_batch' AND batch_uuid IS NOT NULL AND publication_period_start IS NOT NULL AND publication_period_end IS NOT NULL AND publication_period_end >= publication_period_start) OR (event_type <> 'match_results_batch' AND batch_uuid IS NULL AND publication_period_start IS NULL AND publication_period_end IS NULL AND result_count = 1)` [name: 'chk_match_event_shape']
    `publisher_hive_account = lower(publisher_hive_account)` [name: 'chk_match_event_publisher_lower']
    `result_count > 0` [name: 'chk_match_event_result_count']
    `(event_type = 'match_results_batch') OR result_count = 1` [name: 'chk_match_event_change_count']
    `(operation_state <> 'irreversible') OR irreversible_at IS NOT NULL` [name: 'chk_match_event_irreversible']
    `(operation_state <> 'reverted') OR reverted_at IS NOT NULL` [name: 'chk_match_event_reverted']
    `(validation_state <> 'rejected') OR rejection_reason IS NOT NULL` [name: 'chk_match_event_rejection']
    `(operation_state = 'included' AND irreversible_at IS NULL AND reverted_at IS NULL) OR (operation_state = 'irreversible' AND irreversible_at IS NOT NULL AND reverted_at IS NULL) OR (operation_state = 'reverted' AND irreversible_at IS NULL AND reverted_at IS NOT NULL)` [name: 'chk_match_event_state_evidence']
    `(operation_state = 'reverted' AND validation_state = 'reverted' AND rejection_reason IS NULL) OR (operation_state <> 'reverted' AND validation_state = 'accepted' AND rejection_reason IS NULL)` [name: 'chk_match_event_validation_state']
  }

  Note: 'Normalized HAF-derived event root. Initial batch events carry batch/period fields; correction and invalidation lineage is stored in match_result_change. Full validated payload remains on operation.payload. Projector state follows the referenced operation through inclusion, fork rollback, replay, and irreversibility; only allow-listed publisher events are accepted.'
}

Table hive_projection.match_result {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  initial_event_uuid uuid [not null]
  result_position smallint [not null]
  round_id uuid [not null, unique]
  result_schema_version varchar(32) [not null]
  scoring_rule_version varchar(32) [not null]
  map_version_id uuid [not null]
  map_content_sha256 char(64) [not null]
  server_build_version varchar(64) [not null]
  match_protocol_version varchar(32) [not null]
  public_result_sha256 char(64) [not null]
  current_state hive_projection.match_result_current_state [not null, default: 'current']
  current_event_uuid uuid [not null]
  matched_result_revision_id uuid
  reconciliation_state hive_projection.reconciliation_state [not null, default: 'pending']
  reconciled_at timestamptz
  divergence_detected_at timestamptz
  divergence_reason_code varchar(64)
  incident_reference varchar(128)
  ~created_record

  indexes {
    (initial_event_uuid, result_position) [unique, name: 'uq_match_result_event_position']
    (id, round_id) [unique, name: 'uq_match_result_round_identity']
    (map_version_id, created_at) [name: 'idx_match_result_map_version']
    (current_event_uuid, current_state) [name: 'idx_match_result_current_event']
    (reconciliation_state, created_at) [name: 'idx_match_result_reconciliation']
    matched_result_revision_id [name: 'idx_match_result_local_revision']
  }

  checks {
    `result_position >= 0` [name: 'chk_match_result_position']
    `(reconciliation_state <> 'matched') OR (matched_result_revision_id IS NOT NULL AND reconciled_at IS NOT NULL)` [name: 'chk_match_result_matched']
    `(reconciliation_state <> 'divergent') OR (divergence_detected_at IS NOT NULL AND divergence_reason_code IS NOT NULL)` [name: 'chk_match_result_divergent']
  }

  Note: 'Integrity/join cache of an accepted initial Hive summary. Detailed participants, discoveries, and likes remain authoritative in game tables. One accepted initial result per round is enforced; current_event_uuid advances linearly only under projector rules, while the original event remains queryable.'
}

Table hive_projection.match_result_change {
  event_uuid uuid [pk, not null, note: 'Correction/invalidation protocol UUIDv7']
  projected_result_id uuid [not null]
  round_id uuid [not null]
  original_batch_uuid uuid [not null]
  original_event_uuid uuid [not null]
  supersedes_event_uuid uuid [not null]
  change_type hive_projection.match_change_type [not null]
  reason_code varchar(64) [not null]
  replacement_result_revision_id uuid
  replacement_result_schema_version varchar(32)
  replacement_scoring_rule_version varchar(32)
  replacement_map_version_id uuid
  replacement_map_content_sha256 char(64)
  replacement_server_build_version varchar(64)
  replacement_match_protocol_version varchar(32)
  replacement_public_result_sha256 char(64)
  ~created_record

  indexes {
    (round_id, supersedes_event_uuid) [unique, name: 'uq_match_result_change_linear']
    (projected_result_id, round_id) [name: 'idx_match_result_change_result_round']
    (projected_result_id, created_at) [name: 'idx_match_result_change_history']
    original_batch_uuid [name: 'idx_match_result_change_original_batch']
    original_event_uuid [name: 'idx_match_result_change_original_event']
    supersedes_event_uuid [name: 'idx_match_result_change_supersedes']
    replacement_result_revision_id [name: 'idx_match_result_change_revision']
    replacement_map_version_id [name: 'idx_match_result_change_map_version']
  }

  checks {
    `(change_type <> 'correction') OR (replacement_result_revision_id IS NOT NULL AND replacement_result_schema_version IS NOT NULL AND replacement_scoring_rule_version IS NOT NULL AND replacement_map_version_id IS NOT NULL AND replacement_map_content_sha256 IS NOT NULL AND replacement_server_build_version IS NOT NULL AND replacement_match_protocol_version IS NOT NULL AND replacement_public_result_sha256 IS NOT NULL)` [name: 'chk_match_result_change_correction']
    `(change_type <> 'invalidation') OR (replacement_result_revision_id IS NULL AND replacement_result_schema_version IS NULL AND replacement_scoring_rule_version IS NULL AND replacement_map_version_id IS NULL AND replacement_map_content_sha256 IS NULL AND replacement_server_build_version IS NULL AND replacement_match_protocol_version IS NULL AND replacement_public_result_sha256 IS NULL)` [name: 'chk_match_result_change_invalidation']
  }

  Note: 'Append-only correction/invalidation projection. The unique supersedes edge prevents branching; projector triggers require original_event_uuid to be the initial batch and event_uuid to have the matching event type. Replacement public summary detail remains in the validated operation payload.'
}

Table hive_projection.collectible_event {
  event_id uuid [pk, not null]
  operation_id uuid [not null, unique]
  schema_version smallint [not null]
  event_type hive_projection.collectible_event_type [not null]
  collectible_id uuid [not null]
  collectible_definition_id uuid [not null]
  owner_hive_username varchar(16) [not null]
  issuer_hive_username varchar(16) [not null]
  metadata_uri text
  metadata_sha256 char(64)
  issuance_reason varchar(64)
  payment_transaction_id uuid
  occurred_at timestamptz [not null]
  validation_state hive_projection.validation_state [not null, default: 'pending']
  rejection_reason varchar(128)
  ~created_record

  indexes {
    (event_id, collectible_id, collectible_definition_id) [unique, name: 'uq_collectible_event_identity']
    (collectible_id, event_type) [name: 'idx_collectible_event_instance']
    (issuer_hive_username, occurred_at) [name: 'idx_collectible_event_issuer']
    payment_transaction_id [name: 'idx_collectible_event_payment']
    (validation_state, created_at) [name: 'idx_collectible_event_validation']
  }

  checks {
    `schema_version > 0` [name: 'chk_collectible_event_schema_version']
    `owner_hive_username = lower(owner_hive_username)` [name: 'chk_collectible_event_owner_lower']
    `issuer_hive_username = lower(issuer_hive_username)` [name: 'chk_collectible_event_issuer_lower']
    `(validation_state <> 'rejected') OR rejection_reason IS NOT NULL` [name: 'chk_collectible_event_rejection']
  }

  Note: 'Raw chain projection remains auditable even when validation fails. Only accepted allow-listed issuer events update domain ownership.'
}

Table hive_projection.asset_transfer {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  operation_id uuid [not null, unique]
  rail commerce.payment_rail [not null]
  asset_code varchar(16) [not null]
  amount numeric(20,8) [not null]
  sender_hive_account varchar(16) [not null]
  recipient_hive_account varchar(16) [not null]
  memo text
  correlation_reference varchar(256)
  hive_engine_execution_reference varchar(128)
  hive_engine_execution_state hive_projection.hive_engine_execution_state [not null, default: 'not_applicable']
  irreversible_at timestamptz
  consumed_by_payment_id uuid [unique]
  ~created_record

  indexes {
    (recipient_hive_account, asset_code, created_at) [name: 'idx_asset_transfer_recipient']
    correlation_reference [name: 'idx_asset_transfer_correlation']
  }

  checks {
    `rail IN ('hive', 'hive_engine')` [name: 'chk_asset_transfer_rail']
    `asset_code = upper(asset_code)` [name: 'chk_asset_transfer_asset_upper']
    `amount > 0` [name: 'chk_asset_transfer_amount']
    `sender_hive_account = lower(sender_hive_account)` [name: 'chk_asset_transfer_sender_lower']
    `recipient_hive_account = lower(recipient_hive_account)` [name: 'chk_asset_transfer_recipient_lower']
  }

  Note: 'Native HIVE/HBD finality comes from HAF/LIB. AFIT also requires successful Hive-Engine contract execution.'
}

Table hive_projection.community_post {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  author_hive_username varchar(16) [not null]
  permlink varchar(256) [not null]
  created_operation_id uuid [not null, unique]
  latest_operation_id uuid [not null]
  title varchar(256) [not null]
  metadata jsonb [not null, default: '{}']
  created_on_hive_at timestamptz [not null]
  updated_on_hive_at timestamptz [not null]
  cached_vote_count integer [not null, default: 0]
  cached_reward_amount numeric(20,8) [not null, default: 0]
  reward_asset_code varchar(16)
  last_synced_at timestamptz [not null]

  indexes {
    (author_hive_username, permlink) [unique, name: 'uq_community_post_author_permlink']
    latest_operation_id [name: 'idx_community_post_latest_operation']
    (created_on_hive_at) [name: 'idx_community_post_created']
  }

  checks {
    `author_hive_username = lower(author_hive_username)` [name: 'chk_community_post_author_lower']
    `cached_vote_count >= 0` [name: 'chk_community_post_votes']
    `cached_reward_amount >= 0` [name: 'chk_community_post_reward']
  }
}

Table hive_projection.community_vote {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  community_post_id uuid [not null]
  voter_hive_username varchar(16) [not null]
  latest_operation_id uuid [not null]
  vote_weight integer [not null]
  state hive_projection.operation_state [not null]
  voted_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (community_post_id, voter_hive_username) [unique, name: 'uq_community_vote_voter']
    latest_operation_id [name: 'idx_community_vote_operation']
    (voter_hive_username, voted_at) [name: 'idx_community_vote_voter']
  }

  checks {
    `voter_hive_username = lower(voter_hive_username)` [name: 'chk_community_vote_voter_lower']
    `vote_weight BETWEEN -10000 AND 10000` [name: 'chk_community_vote_weight']
  }
}

Table hive_projection.transaction_intent {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  idempotency_key varchar(128) [not null, unique]
  player_id uuid
  auth_session_id uuid
  operation_kind varchar(64) [not null]
  required_authority hive_projection.authority_type [not null]
  canonical_operation_hash char(64) [not null]
  authorization_mode hive_projection.authorization_mode [not null]
  hive_signing_provider identity.signing_provider
  custody_key_reference_id uuid
  official_service_role hive_projection.service_account_role
  allowlist_policy_version varchar(32) [not null]
  authorization_validated_at timestamptz [not null]
  state hive_projection.transaction_state [not null, default: 'requested']
  requested_at timestamptz [not null, default: `now()`]
  expires_at timestamptz [not null]
  hive_transaction_id varchar(128)
  failure_code varchar(64)
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (player_id, requested_at) [name: 'idx_transaction_intent_player']
    (auth_session_id, requested_at) [name: 'idx_transaction_intent_session']
    (custody_key_reference_id, requested_at) [name: 'idx_transaction_intent_custody_key']
    (official_service_role, requested_at) [name: 'idx_transaction_intent_service_role']
    (state, expires_at) [name: 'idx_transaction_intent_state']
    hive_transaction_id [name: 'idx_transaction_intent_hive_tx']
  }

  checks {
    `expires_at > requested_at` [name: 'chk_transaction_intent_expiry']
    `(authorization_mode <> 'external_wallet') OR (player_id IS NOT NULL AND auth_session_id IS NOT NULL AND hive_signing_provider IS NOT NULL AND hive_signing_provider <> 'custodial_service' AND custody_key_reference_id IS NULL AND official_service_role IS NULL)` [name: 'chk_transaction_intent_external']
    `(authorization_mode <> 'custodial_player') OR (player_id IS NOT NULL AND auth_session_id IS NOT NULL AND hive_signing_provider = 'custodial_service' AND custody_key_reference_id IS NOT NULL AND official_service_role IS NULL)` [name: 'chk_transaction_intent_custodial']
    `(authorization_mode <> 'official_service') OR (player_id IS NULL AND auth_session_id IS NULL AND hive_signing_provider IS NULL AND custody_key_reference_id IS NULL AND official_service_role IS NOT NULL)` [name: 'chk_transaction_intent_official']
  }

  Note: 'Separates authenticated player intent from its Hive signer and from official service operations. Contains no private keys, raw Google tokens, or wallet/service secrets. Custodial signing requires a current allow-listed intent and eligible session; canonical hash is intentionally not globally unique.'
}

Table hive_projection.rc_delegation {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  player_id uuid
  provisioning_id uuid
  recipient_hive_username varchar(16) [not null]
  delegator_hive_account varchar(16) [not null]
  delegator_kind hive_projection.rc_delegator_kind [not null]
  delegator_service_role hive_projection.service_account_role
  purpose hive_projection.rc_delegation_purpose [not null]
  required_authority hive_projection.authority_type [not null, default: 'posting']
  application_id varchar(64) [not null, default: 'rc']
  payload_operation varchar(64) [not null, default: 'delegate_rc']
  delegated_max_rc numeric(30,0) [not null]
  grant_operation_id uuid
  reclaim_operation_id uuid
  status hive_projection.rc_delegation_status [not null, default: 'pending']
  granted_at timestamptz
  last_used_at timestamptz
  reclaimed_at timestamptz
  eligible_at timestamptz
  cooldown_until timestamptz
  eligibility_metadata jsonb [not null, default: '{}']
  ~created_record

  indexes {
    (recipient_hive_username, status) [name: 'idx_rc_delegation_recipient']
    (delegator_hive_account, status) [name: 'idx_rc_delegation_delegator']
    (provisioning_id, purpose) [name: 'idx_rc_delegation_provisioning']
    (player_id, purpose, status) [name: 'idx_rc_delegation_player']
    grant_operation_id [name: 'idx_rc_delegation_grant_operation']
    reclaim_operation_id [name: 'idx_rc_delegation_reclaim_operation']
    (status, eligible_at, cooldown_until) [name: 'idx_rc_delegation_eligibility']
  }

  checks {
    `player_id IS NOT NULL OR provisioning_id IS NOT NULL` [name: 'chk_rc_delegation_subject']
    `recipient_hive_username = lower(recipient_hive_username)` [name: 'chk_rc_delegation_recipient_lower']
    `delegator_hive_account = lower(delegator_hive_account)` [name: 'chk_rc_delegation_delegator_lower']
    `(delegator_kind = 'approved_signup_sponsor' AND delegator_service_role IS NULL) OR (delegator_kind = 'platform_rc_support' AND delegator_service_role = 'rc_support')` [name: 'chk_rc_delegation_owner']
    `(purpose <> 'initial_provisioning') OR (provisioning_id IS NOT NULL AND delegator_kind = 'approved_signup_sponsor')` [name: 'chk_rc_delegation_initial']
    `(purpose <> 'general_support') OR (player_id IS NOT NULL AND delegator_kind = 'platform_rc_support')` [name: 'chk_rc_delegation_general']
    `required_authority = 'posting' AND application_id = 'rc' AND payload_operation = 'delegate_rc'` [name: 'chk_rc_delegation_wrapper']
    `delegated_max_rc > 0` [name: 'chk_rc_delegation_max_rc']
    `cooldown_until IS NULL OR eligible_at IS NULL OR cooldown_until >= eligible_at` [name: 'chk_rc_delegation_cooldown']
  }

  Note: 'RC is max_rc capacity, not HIVE, HP, or content-vote weight. Initial capacity is supplied by the approved signup sponsor and projected from observed Hive evidence; a separate platform rc_support role may grant later general support. Grant/reclaim evidence uses posting-authority custom_json application id rc with a delegate_rc payload. Migration adds partial active uniqueness by delegator, recipient, and purpose; initial provisioning may exist before player creation and is linked later.'
}

Table hive_projection.sync_cursor {
  source varchar(64) [pk, not null]
  endpoint_url text [not null]
  last_processed_block bigint [not null, default: 0]
  last_irreversible_block bigint [not null, default: 0]
  last_successful_sync_at timestamptz
  health hive_projection.sync_health [not null, default: 'healthy']
  last_error_code varchar(64)
  updated_at timestamptz [not null, default: `now()`]

  checks {
    `last_processed_block >= 0` [name: 'chk_sync_cursor_processed_block']
    `last_irreversible_block >= 0 AND last_irreversible_block <= last_processed_block` [name: 'chk_sync_cursor_irreversible_block']
  }
}

