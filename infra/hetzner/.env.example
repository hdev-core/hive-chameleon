HC_PUBLIC_ORIGIN=https://hive-signer.cloverapis.xyz
HC_PUBLIC_WEBSOCKET_URL=wss://hive-signer.cloverapis.xyz/ws
HC_API_BIND_PORT=3000
HC_NAKAMA_BIND_PORT=7350

HC_DATABASE_OWNER_PASSWORD=replace-with-random-hex
HC_API_DB_PASSWORD=replace-with-random-hex
HC_NAKAMA_DB_PASSWORD=replace-with-random-hex
NAKAMA_DATABASE_PASSWORD=replace-with-random-hex

AUTH_TOKEN_SECRET=replace-with-32-random-bytes-as-unpadded-base64url
AUTH_IDENTITY_LOOKUP_KEY=replace-with-different-32-random-bytes-as-unpadded-base64url
NAKAMA_BRIDGE_HMAC_KEY=replace-with-different-32-random-bytes-as-unpadded-base64url
NAKAMA_SERVER_KEY=replace-with-a-unique-public-application-key
NAKAMA_RUNTIME_HTTP_KEY=replace-with-random-hex
NAKAMA_SESSION_ENCRYPTION_KEY=replace-with-random-hex
NAKAMA_REFRESH_ENCRYPTION_KEY=replace-with-different-random-hex
NAKAMA_CONSOLE_USERNAME=replace-with-admin-name
NAKAMA_CONSOLE_PASSWORD=replace-with-random-hex
NAKAMA_CONSOLE_SIGNING_KEY=replace-with-random-hex
