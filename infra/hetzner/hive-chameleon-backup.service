[Unit]
Description=Back up Hive Chameleon PostgreSQL databases
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/hive-chameleon-backup
Nice=10
IOSchedulingClass=idle
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/hive-chameleon

